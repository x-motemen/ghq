{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  enabledManagers: [
    'gomod',
    'github-actions',
  ],
  packageRules: [
    {
      matchManagers: [
        'gomod',
      ],
      matchDepTypes: [
        'require',
        'indirect',
      ],
      enabled: false,
    },
    {
      matchManagers: [
        'gomod',
      ],
      matchDepTypes: [
        'require',
      ],
      matchPackageNames: [
        '/^github\\.com/urfave/cli(?:/v\\d+)?$/',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: true,
      postUpdateOptions: [
        'gomodUpdateImportPaths',
      ],
      automerge: false,
    },
    {
      matchManagers: [
        'gomod',
      ],
      matchDepNames: [
        'go',
      ],
      matchDepTypes: [
        'golang',
        'toolchain',
      ],
      rangeStrategy: 'bump',
      enabled: true,
      automerge: false,
    },
  ],
}
